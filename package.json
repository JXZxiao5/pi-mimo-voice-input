{
  "name": "pi-mimo-voice-input",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi MiMo 语音输入扩展 — 中文 ASR、本地 VAD、可选口语整理与录音自检",
  "keywords": ["pi-package", "pi-extension", "voice", "voice-input", "speech-to-text", "stt", "asr", "chinese", "mimo", "xiaomi", "webrtc", "vad"],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": { "node": ">=22.19.0" },
  "author": "mlosun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlosun/pi-mimo-voice-zh.git"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "prepack": "npm test",
    "test:cleanup-live": "node --experimental-strip-types scripts/test-cleanup-live.ts"
  },
  "devDependencies": {
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "src/*.ts",
    "package.json",
    "examples/mimo-voice-input.example.json",
    "README.md",
    "docs/*.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ricky0123/vad-web": "0.0.31",
    "onnxruntime-web": "1.22.0"
  }
}
